# environment variables and secrets
.env
.env.*
!.env.example

# python virtual environments
.venv/
venv/

# python cache and build artifacts
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/

# node (future apps/web, apps/runner)
node_modules/

# Next.js build output (packages/web)
.next/

# TypeScript incremental build cache (packages/web's tsconfig.json)
*.tsbuildinfo

# local databases (Phase 3), including WAL sidecar files
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# os metadata
.DS_Store

# local application data (introduced in a later phase, excluded defensively now)
data/
.theopentranscribe/

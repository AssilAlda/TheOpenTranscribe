# Optional: your OpenAI API key, used for audio transcription
# (gpt-4o-transcribe). If unset, you can instead configure a key from the
# web dashboard's Provider settings page (stored in
# THEOPENTRANSCRIBE_CONFIG_DIR) -- an env-set key here always takes
# precedence over a dashboard-managed one.
OPENAI_API_KEY=

# Required (packages/db, packages/runner, packages/web): absolute path to a
# local directory for the SQLite database and managed uploads/outputs. All
# three must point at the *same* directory. In Docker, this is set to /data
# by docker-compose.yml and backed by the `data_dir` named volume -- you
# normally don't need to set this yourself when using Docker.
DATA_DIR=

# Optional (packages/provider-config, via packages/runner and
# packages/web): absolute path to a directory for the managed provider
# credential file. Independent of DATA_DIR. Falls back to
# $XDG_CONFIG_HOME/theopentranscribe or ~/.theopentranscribe if unset. In
# Docker, this is set to /config by docker-compose.yml and backed by the
# `config_dir` named volume.
THEOPENTRANSCRIBE_CONFIG_DIR=

# Optional (packages/web): comma-separated list of additional trusted
# origins (exact scheme+host+port, e.g.
# "http://192.168.1.50:3000,http://transcribe.lan:3000") allowed to call
# the Provider/settings API. http(s)://localhost, 127.0.0.1, and [::1] are
# always trusted automatically, at any port -- you do not need to set this
# for the default "browse via localhost" deployment. This is CSRF/origin
# protection only, not authentication, and exposing the app to the public
# internet is not made secure by this setting or by Docker itself -- put a
# reverse proxy, VPN, or other access-control layer in front of it first.
THEOPENTRANSCRIBE_TRUSTED_ORIGINS=

{
  "name": "@theopentranscribe/web",
  "version": "0.1.0",
  "description": "Web API (Next.js Route Handlers) + dashboard UI: upload handling + validation, job creation, job/history queries, serving results, and a dashboard for uploading, tracking, reading, and exporting transcripts.",
  "private": true,
  "scripts": {
    "build:provider-config": "npm --prefix ../provider-config install --no-audit --no-fund --include=dev && npm --prefix ../provider-config run build",
    "predev": "npm run build:provider-config",
    "dev": "next dev",
    "prebuild": "npm run build:provider-config",
    "build": "next build",
    "prestart": "npm run build:provider-config",
    "start": "next start",
    "pretest": "npm run build:provider-config",
    "test": "vitest run",
    "pretypecheck": "npm run build:provider-config",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/busboy": "3.2.2",
    "@theopentranscribe/db": "file:../db",
    "@theopentranscribe/provider-config": "file:../provider-config",
    "fontkit": "^2.0.4",
    "next": "^16.3.5",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

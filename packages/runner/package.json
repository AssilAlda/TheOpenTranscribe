{
  "name": "@theopentranscribe/runner",
  "version": "0.1.0",
  "description": "Lightweight TypeScript job runner. Polls packages/db for QUEUED jobs and invokes the Python transcriber as a subprocess.",
  "type": "module",
  "main": "./src/index.ts",
  "private": true,
  "scripts": {
    "build:provider-config": "npm --prefix ../provider-config install --no-audit --no-fund --include=dev && npm --prefix ../provider-config run build",
    "prestart": "npm run build:provider-config",
    "start": "tsx src/index.ts",
    "pretest": "npm run build:provider-config",
    "test": "vitest run",
    "pretypecheck": "npm run build:provider-config",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@theopentranscribe/db": "file:../db",
    "@theopentranscribe/provider-config": "file:../provider-config"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
